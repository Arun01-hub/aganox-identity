@{
    var layoutMode = ViewData["LayoutMode"] as string ?? "auth";
    var isAdmin = layoutMode == "admin";
    var isSignedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Aganox Identity — secure sign-in and authorization for Aganox applications." />
    <title>@ViewData["Title"] - Aganox Identity</title>
    <link rel="stylesheet" href="~/css/identity-enterprise/identity-enterprise.css" asp-append-version="true" />
</head>
<body class="identity-shell identity-shell--@layoutMode">
    <header class="identity-shell__header">
        <a href="/" class="identity-shell__brand">
            <span class="identity-shell__logo" aria-hidden="true">A</span>
            <span>Aganox Identity</span>
        </a>
        @if (!isAdmin)
        {
            <span class="identity-shell__tagline">Secure sign-in for Aganox apps</span>
        }
        else
        {
            <span class="identity-shell__tagline">Application registry &amp; OAuth clients</span>
        }
        <div class="identity-shell__header-end">
            @if (isAdmin)
            {
                <button type="button" class="identity-shell__nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="shell-nav">
                    <span class="sr-only">Menu</span>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M4 7h16M4 12h16M4 17h16"/>
                    </svg>
                </button>
            }
            <nav id="shell-nav" class="identity-shell__nav" data-shell-nav aria-label="Primary">
                @if (User.IsInRole("Administrator"))
                {
                    <a class="identity-shell__nav-link @(isAdmin ? "is-active" : null)"
                       asp-page="/Admin/Applications/Index">Applications</a>
                }
                @if (isSignedIn)
                {
                    <a class="identity-shell__nav-link" asp-page="/Account/Logout">Sign out</a>
                }
                else
                {
                    <a class="identity-shell__nav-link" asp-page="/Account/Login">Sign in</a>
                }
            </nav>
        </div>
    </header>
    <main class="identity-shell__main">
        @RenderBody()
    </main>
    <footer class="identity-shell__footer">
        <p>&copy; @DateTime.UtcNow.Year Aganox Identity</p>
    </footer>
    <script src="~/js/identity-ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
