@page "{id:guid}"
@model Aganox.IdentityServer.Pages.Admin.Applications.CredentialsModel
@{
    ViewData["Title"] = "Credentials";
    ViewData["ApplicationId"] = Model.Application.Id;
    ViewData["AdminNavActive"] = "credentials";
    ViewData["Breadcrumb"] = new List<(string, string?)>
    {
        ("Applications", Url.Page("Index")),
        (Model.Application.DisplayName, Url.Page("Details", new { id = Model.Application.Id })),
        ("Credentials", null)
    };
}

<partial name="_AdminBreadcrumb" />
<partial name="_AdminAppNav" />

<section class="card card--wide">
    <div class="page-header">
        <h1 class="page-header__title">Credentials</h1>
        <p class="card__lead">Secrets are shown once after rotation. Store them in your secret manager immediately.</p>
    </div>

    @if (!Model.SupportsSecrets)
    {
        <div class="empty-state">
            <p class="empty-state__title">Public client</p>
            <p class="empty-state__text">This application type does not use client secrets. Use PKCE and redirect URI restrictions instead.</p>
            <a asp-page="Details" asp-route-id="@Model.Application.Id" class="btn btn--secondary">Back to overview</a>
        </div>
    }
    else
    {
        @if (Model.Application.PrimaryCredential is { } credential)
        {
            <div class="dl-grid" style="margin-bottom: 1rem;">
                <div class="dl-grid__item">
                    <div class="dl-grid__label">Primary credential</div>
                    <div class="dl-grid__value"><code>…@credential.SecretPrefix</code></div>
                </div>
                <div class="dl-grid__item">
                    <div class="dl-grid__label">Created (UTC)</div>
                    <div class="dl-grid__value">@credential.CreatedAt.ToString("u")</div>
                </div>
            </div>
        }
        else
        {
            <p class="text-muted">No active primary credential.</p>
        }

        @if (!string.IsNullOrEmpty(Model.PlaintextSecret))
        {
            <div class="alert alert--warning" role="alert">
                <strong>Copy this secret now.</strong> It will not be shown again.
                <pre class="secret-display" id="plaintext-secret">@Model.PlaintextSecret</pre>
                <div class="copy-row mt-4">
                    <button type="button" class="btn btn--primary" data-copy="plaintext-secret" data-copy-label="Copy secret">Copy secret</button>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert--error" role="alert">@Model.ErrorMessage</div>
        }

        <div class="form__actions form__actions--row">
            <form method="post" asp-page-handler="Rotate">
                <button type="submit" class="btn btn--primary">Rotate secret</button>
            </form>
            <form method="post" asp-page-handler="Revoke">
                <button type="submit" class="btn btn--danger">Revoke secret</button>
            </form>
        </div>
    }
</section>
