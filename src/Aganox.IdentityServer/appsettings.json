{
  "ConnectionStrings": {
    "IdentityDb": "Server=(localdb)\\mssqllocaldb;Database=AganoxIdentity;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Identity": {
    "Issuer": "https://localhost:7036",
    "DefaultClientUrl": "http://rental.aganox.local:4200"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://rental.aganox.local:4200"
    ]
  },
  "ApplicationRegistry": {
    "ClientIdPrefix": "aganox",
    "AllowExplicitClientId": false,
    "ProductionRequireHttpsRedirects": true,
    "ProductionAllowedRedirectHosts": [
      "aganox.com",
      "rental.aganox.com"
    ],
    "DevelopmentRedirectHostExceptions": [
      "localhost",
      "127.0.0.1",
      "rental.aganox.local"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
